  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "netlify-cli": "^27.14.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  }
